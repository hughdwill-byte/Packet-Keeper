  "method": [
    {
      "text": "Heat 2 tbsp of oil in a large pot over medium heat. Add onion, garlic & tomato paste. Cook for 3 mins.",
      "source": "reconstructed"
    },
    {
      "text": "Add protein & Mingle recipe base, cooking until browned. Add remaining veggies. Cook for 2 mins.",
      "source": "reconstructed"
    },
    {
      "text": "Add passata, tin of tomatoes & stock. Cover the pot & lower heat to simmer for 20 mins. Optional: to elevate your dish even further, add 150mL milk & cook for an additional 10 mins.",
      "source": "reconstructed"
    },
    {
      "text": "Serve with zucchini noodles or pasta. Top with some parmesan cheese. Yummo!",
      "source": "reconstructed"
    }
