  "method": [
    {
      "text": "Heat 2 tbsp of oil in a pot over medium heat. Add onion & cook until translucent.",
      "source": "reconstructed"
    },
    {
      "text": "Add protein & cook until browned. Now stir in tomato paste & Mingle's recipe base & cook for 1-2 mins. Add remaining veg including black beans.",
      "source": "reconstructed"
    },
    {
      "text": "Add in stock, tinned tomatoes & simmer for 25 mins stirring occasionally. Leave covered off the heat for 10 mins to cool - this will make it taste better.",
      "source": "reconstructed"
    },
    {
      "text": "Serve with rice topped with crushed corn chips, a dollop of sour cream, a squeeze of lime & some grated cheese. Yummo!",
      "source": "reconstructed"
    }
  ],
