  "method": [
    {
      "text": "Toast the contents of the recipe base in a dry large pan over a low heat for 1-2 mins until fragrant. Now add 3 tbsp coconut oil.",
      "source": "reconstructed"
    },
    {
      "text": "Add onions & cook until translucent. Then add your tomatoes & protein. Cook for 5 mins.",
      "source": "reconstructed"
    },
    {
      "text": "Stir in coconut cream & chicken stock. Simmer for 5 mins. Add remaining veg & simmer for 15 mins or until desired thickness. Rest 5 mins before serving.",
      "source": "reconstructed"
    },
    {
      "text": "Serve with rice. Top with curry leaves, peanuts & lime. Yummo!",
      "source": "reconstructed"
    }
  ],
