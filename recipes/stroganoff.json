  "method": [
    {
      "text": "Heat 2 tbsp of olive oil in a pot over medium heat. Add protein & tomato paste and cook for 3 mins.",
      "source": "reconstructed"
    },
    {
      "text": "Mix in mushrooms until softened. Add Mingle recipe base & remaining veg.",
      "source": "reconstructed"
    },
    {
      "text": "Add in the stock & lower the heat to simmer for 20 mins. Add spinach & sour cream and let wilt with the heat off.",
      "source": "reconstructed"
    },
    {
      "text": "Serve with your pasta & chives. Yummo!",
      "source": "reconstructed"
    }
