  "method": [
    {
      "text": "Heat 2 tbsp of oil in a pan. Add protein & brown over high heat for 5 mins.",
      "source": "reconstructed"
    },
    {
      "text": "Add onions & capsicum, cook until translucent. Add tomato paste & Mingle recipe base. Cook for 4 mins, then add remaining veggies.",
      "source": "reconstructed"
    },
    {
      "text": "Add stock & simmer over medium heat for 15 mins until the stock has reduced.",
      "source": "reconstructed"
    },
    {
      "text": "Serve with tortillas or in a bowl with any of your toppings. Mingle's extra spice is killer. Yummo!",
      "source": "reconstructed"
