  "method": [
    {
      "text": "Preheat oven to 180°C. Now heat butter in a pot over medium heat. Add butter, tomato paste & Mingle recipe base. Cook for 3 mins. Meanwhile, cook your pasta for 2 mins less than the instructions.",
      "source": "reconstructed"
    },
    {
      "text": "Add protein to the remaining pot, cook until browned. Add sour cream, cream cheese, lemon juice, stock & remaining veggies (exclude spinach). Cook until cheese melts.",
      "source": "reconstructed"
    },
    {
      "text": "Transfer pasta & sauce to a baking tray. Top with spring onion & cheese, then bake until golden.",
      "source": "reconstructed"
    },
    {
      "text": "Serve with a wedge of lemon. Yummo!",
      "source": "reconstructed"
    }
  ],
