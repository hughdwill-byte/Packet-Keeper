  "method": [
    {
      "text": "Prepare by separating a portion (10g) of Mingle's sachet. Set aside for use at the end of the recipe. Now heat 2 tbsp sesame oil in a pan. Add protein for approx 5 mins.",
      "source": "reconstructed"
    },
    {
      "text": "Add all veg (minus the spring onions), cook for 2 mins. Add the Mingle recipe base, rice & stock. Cook over low heat until rice is cooked, approx 25 mins. Stir occasionally.",
      "source": "reconstructed"
    },
    {
      "text": "Take off heat & stir in the set-aside Mingle sachet & let it rest for a minute.",
      "source": "reconstructed"
    },
    {
      "text": "Serve with chopped spring onions & crushed peanuts. Yummo!",
      "source": "reconstructed"
    }
  ],
