  "method": [
    {
      "text": "Heat 2 tbsp of coconut oil or ghee in a large pot over medium heat. Add onion & cook for 3 mins.",
      "source": "reconstructed"
    },
    {
      "text": "Add in Mingle's recipe base & protein, cooking until lightly browned. Add remaining veg. Cook for 2 mins.",
      "source": "reconstructed"
    },
    {
      "text": "Stir in the peanut butter, coconut cream & stock. Cover the pot & lower the heat to simmer for 20 mins.",
      "source": "reconstructed"
    },
    {
      "text": "Serve with rice or noodles. Top with crushed peanuts & a squeeze of fresh lime. Yummo!",
      "source": "reconstructed"
    }
  ],
