  "method": [
    {
      "text": "Heat 2 tbsp of oil in a pan over medium heat. Brown your protein at a high heat until lightly browned.",
      "source": "reconstructed"
    },
    {
      "text": "Add onions & cook until translucent. Now add tomato paste & your Mingle recipe base. Cook for 4 mins.",
      "source": "reconstructed"
    },
    {
      "text": "Add in stock & remaining veggies. Simmer over medium heat for 15 mins until the stock has dissolved.",
      "source": "reconstructed"
    },
    {
      "text": "Serve with tortillas or in a bowl with any of your toppings. Mingle's extra spice is killer. Yummo!",
      "source": "reconstructed"
    }
  ],
