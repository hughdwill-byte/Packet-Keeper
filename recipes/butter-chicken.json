  "method": [
    {
      "text": "Heat 2 tbsp of oil in a large pot over medium heat. Add onion & cook until translucent.",
      "source": "reconstructed"
    },
    {
      "text": "Add protein & Mingle recipe base, cooking until lightly browned. Add remaining veg & cook for an additional 2 mins.",
      "source": "reconstructed"
    },
    {
      "text": "Add in tomato passata, butter, cream & stock. Cover the pot & lower the heat to simmer for 20 mins.",
      "source": "reconstructed"
    },
    {
      "text": "Serve with rice, crushed cashews & a dollop of yoghurt. Yummo!",
      "source": "reconstructed"
    }
  ],
